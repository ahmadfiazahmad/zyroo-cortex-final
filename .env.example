# Cortex AI Backend — copy to .env and paste your own keys. Never commit .env.
DATABASE_URL=sqlite:///./cortex.db
# Production example: DATABASE_URL=postgresql://user:password@host:5432/cortex

JWT_SECRET=change-me-to-a-long-random-secret

# Embeddings: "hash" (default, offline, tests) or "fastembed" (real neural
# embeddings, all-MiniLM-L6-v2 — set this in production for true semantic search).
EMBEDDING_PROVIDER=hash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
APP_BASE_URL=http://localhost:8000

# Comma-separated emails that become admin on registration.
ADMIN_EMAILS=
